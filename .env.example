# =============================================================================
# Medical Research Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# ---- LLM Configuration (Phase 1) ----
LLM_PROVIDER=litellm
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434

# ---- Model Selection (Phase 1) ----
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# ---- Data Backends ----
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GCP_BUCKET_NAME=your-bucket

# ---- LangSmith Observability (Phase 5) ----
# Leave LANGSMITH_API_KEY empty to disable tracing (graceful degradation).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-research-agent

# ---- Prometheus Metrics (Phase 5) ----
# Port where prometheus_client exposes /metrics.
PROMETHEUS_PORT=9000

# ---- Logging (Phase 5) ----
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
AZURE_API_BASE=
AZURE_API_KEY=
AZURE_API_VERSION=2024-02-01
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
OLLAMA_BASE_URL=http://localhost:11434